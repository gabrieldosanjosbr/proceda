{
  "name": "gabrieldosanjosbr/proceda",
  "description": "Biblioteca PHP para layouts PROCEDA (NOTFIS, OCOREN, CONEMB e DOCCOB)",
  "authors": [
    {
      "name":"Gabriel dos Anjos",
      "email": "gabrieldosanjos@outlook.com"
    }
  ],
  "keywords": [
    "edi",
    "proceda",
    "notfis",
    "ocoren",
    "logistica",
    "transporte",
    "frete"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "symfony/yaml": "^7.4",
    "symfony/serializer": "^7.4",
    "symfony/property-access": "^7.4",
    "symfony/property-info": "^7.4",
    "phpstan/phpdoc-parser": "^2.3",
    "phpdocumentor/type-resolver": "^2.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/gabrieldosanjosbr/proceda-fixtures"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.2",
    "symfony/var-dumper": "^7.4",
    "phpstan/phpstan": "^2.2",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.95",
    "symfony/console": "^7.4",
    "phpmd/phpmd": "^2.15",
    "proceda/fixtures": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Proceda\\": [
        "src/",
        "src/Domain/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Proceda\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test:writer": "phpunit --testsuite writer",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "process-timeout": 0
  }
}
